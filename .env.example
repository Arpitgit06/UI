# Copy to .env and adjust as needed.
OMNIUI_MIN_FREE_VRAM_MB=512
OMNIUI_CUDA_DEVICE=0

# Module B: Spatial Vision & Detection
# yolov10n.pt is stock/COCO-pretrained -- swap in a UI-fine-tuned checkpoint
# (e.g. trained on Rico) under models_cache/ for real button/navbar detection.
OMNIUI_YOLO_WEIGHTS=yolov10n.pt
OMNIUI_YOLO_CONF=0.25
OMNIUI_OCR_LANG=en
OMNIUI_OCR_CONF=0.5
OMNIUI_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
OMNIUI_COLORS_PER_ELEMENT=3

# Module C: DOM Synthesizer
OMNIUI_DOM_CONTAINMENT_THRESHOLD=0.8

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=qwen2-vl:7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_KEEP_ALIVE_SECONDS=120
OLLAMA_MAX_RETRIES=2
OLLAMA_STRICT_VALIDATION=true
