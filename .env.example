# OmniUI runs offline after setup caches VL, coder, OCR and LTX assets.
OMNIUI_OFFLINE=true
OMNIUI_CUDA_DEVICE=0
OMNIUI_MAX_KEY_STATES=12
OMNIUI_MAX_UPLOAD_MB=512
OMNIUI_MAX_VIDEO_SECONDS=600
OMNIUI_MAX_VIDEO_PIXELS=8294400
OMNIUI_MAX_PENDING_JOBS=8
OMNIUI_WORKER_TIMEOUT_SEC=600

# Optional UI-trained checkpoints only. COCO checkpoints are excluded.
# OMNIUI_YOLO_MACRO_WEIGHTS=models_cache/ui_macro.pt
# OMNIUI_YOLO_MICRO_WEIGHTS=models_cache/ui_micro.pt
OMNIUI_YOLO_CONF=0.25
OMNIUI_YOLO_EXPORT_ONNX=false
OMNIUI_OCR_LANG=en
OMNIUI_OCR_CONF=0.5
OMNIUI_DOM_CONTAINMENT_THRESHOLD=0.8

OMNIUI_VISION_DETECTOR_MODEL=Qwen/Qwen2-VL-7B-Instruct
OMNIUI_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
OMNIUI_CODE_GENERATOR=qwen
OMNIUI_VISION_MAX_TOKENS=4096
OMNIUI_VISION_MAX_PIXELS=921600
OMNIUI_LLM_4BIT=true
# Qwen stages use NF4; measured geometry and browser validation remain code-driven.
OMNIUI_VISUAL_VERIFICATION=true
# Set true to refuse completion if browser validation is unavailable.
OMNIUI_REQUIRE_VISUAL_VERIFICATION=true
# Optional existing Chromium executable for the browser validator:
# OMNIUI_CHROMIUM_PATH=C:/path/to/chrome.exe
OMNIUI_MOTION_MAX_SAMPLES=80
OMNIUI_MOTION_MAX_REGIONS=4

# Local GPU budget: at most 7 GiB per sequential stage, leaving driver/UI headroom.
# LTX generates artwork candidates; native controls are React components.
OMNIUI_ARTWORK_GENERATOR=ltx-2b-fp16
# OMNIUI_ARTWORK_GENERATOR=preserve
# OMNIUI_ARTWORK_GENERATOR=ltx-2b-q8
